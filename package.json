{
  "name": "web.base.io",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#components/*": "./client/components/*.tsx",
    "#enumerators/*": "./enumerators/*.ts",
    "#gateways/*": "./server/gateways/*.ts",
    "#jobs/*": "./server/jobs/*.ts",
    "#loggers": "./server/loggers/index.ts",
    "#loggers/*": "./server/loggers/*.ts",
    "#middlewares/*": "./server/middlewares/*.ts",
    "#models/*": "./server/models/*.ts",
    "#problem": "./server/problem.ts",
    "#routes/*": "./server/routes/*.ts",
    "#storage/*": "./server/storage/*.ts",
    "#strategies/*": "./server/strategies/*.ts",
    "#locales/*": "./locales/*.ts"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/server.ts",
    "build": "tsc -b && npm run build:client && npm run build:server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr client/entry-server.tsx --outDir dist/server",
    "database:reset": "node --env-file-if-exists=.env server/reset.ts",
    "start": "cross-env NODE_ENV=production node --env-file-if-exists=.env server/server.ts",
    "format": "prettier --write --log-level silent",
    "format:check": "prettier --check --log-level silent",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@agendajs/mongo-backend": "^4.0.3",
    "@azure/storage-blob": "^12.33.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.103.0",
    "agenda": "^6.2.6",
    "bcrypt": "^6.0.0",
    "cally": "^0.9.2",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "connect-mongo": "^6.0.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "handlebars": "^4.7.9",
    "i18next": "^26.4.2",
    "mongoose": "^9.10.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.88.0",
    "react-hot-toast": "^2.6.0",
    "sirv": "^3.0.2",
    "temporal-polyfill": "^1.0.5",
    "winston": "^3.19.0",
    "wouter": "^3.11.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.5.0",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "daisyui": "^5.7.38",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.2.2"
  }
}
